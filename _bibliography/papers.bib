@misc{Zeng2025,
  abbr = {In preparation},
  title        = {Geometric Higher Stacks on Singular Foliations},
  author       = {Qingyun Zeng},
  year         = {2025},
  eprint       = {In preparation},
  primaryClass = {math.DG},
  abstract     = {Work in progress. We study the geometric higher stacks presented by Lie infinity groupoids associated to singualar foliations on smooth manifolds in the sense of Stefen-Sussmann. We show that the geometric higher stacks are equivalent to the derived moduli stacks of Lie infinity algebroids associated to singular foliations. We also study the derived moduli stacks of Lie infinity algebroids associated to holomorphic singular foliations on complex manifolds.}
